{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [ "${mod_authors}" ],
  "contact": {
    "homepage": "${version_control}",
    "issues": "${discord_link}",
    "sources": "${version_control}"
  },
  "license": "${mod_license}",
  "icon": "pack.png",
  "entrypoints": {
    "fabric-datagen": [
      "xyz.quazaros.ghastfire.client.GhastFireDataGenerator"
    ],
    "main": [
      "xyz.quazaros.ghastfire.GhastFire"
    ],
    "client": [
      "xyz.quazaros.ghastfire.client.GhastFire73Client"
    ],
    "modmenu": [
      "xyz.quazaros.ghastfire.client.configScreen.GhastFire73ModMenu"
    ]

  },
  "mixins": [
    "ghastfire73.mixins.json",
    {
      "config": "ghastfire73.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "${discord_link}"
      }
    }
  }
}